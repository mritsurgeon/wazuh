<group name="Veeam_Backup_Replication_v12.1 Error">
  <rule id="100071" level="8">
    <decoded_as>Veeam MP</decoded_as>
    <description>$(Description)</description>
    <field name="Object">Restore point</field>
    <field name="State">removed</field>
    <mitre><id>T1490</id></mitre>
    <group>syscheck,pci_dss_11.5,gpg13_4.11,gdpr_II_5.1.f,</group>
  </rule>

  <rule id="100072" level="8">
    <decoded_as>Veeam MP</decoded_as>
    <description>Job $(JobName) finished with Failed or Error</description>
    <match>finished with Failed</match>
    <group>syscheck,pci_dss_11.5,gpg13_4.11,gdpr_II_5.1.f,</group>
  </rule>

  <rule id="100073" level="8">
    <decoded_as>Veeam MP</decoded_as>
    <description>$(Description)</description>
    <field name="workload">^Agent|^Vm</field>
    <field name="State">deleted</field>
    <mitre><id>T1490</id></mitre>
    <group>syscheck,pci_dss_11.5,gpg13_4.11,gdpr_II_5.1.f,</group>
  </rule>

  <rule id="100074" level="8">
    <decoded_as>Veeam MP</decoded_as>
    <description>objects has been $(State) by $(User)</description>
    <match>objects has been deleted</match>
    <mitre><id>T1490</id></mitre>
    <group>syscheck,pci_dss_11.5,gpg13_4.11,gdpr_II_5.1.f,</group>
  </rule>

  <!-- Enhanced error rules for new event types -->
  <rule id="100075" level="8">
    <decoded_as>Veeam MP</decoded_as>
    <description>$(Description)</description>
    <field name="Object">License</field>
    <field name="State">expired|support expired</field>
  </rule>

  <rule id="100076" level="8">
    <decoded_as>Veeam MP</decoded_as>
    <description>$(Description)</description>
    <field name="Object">Adding User or Group</field>
    <field name="State">Failed</field>
    <mitre><id>T1531</id></mitre>
  </rule>

  <rule id="100077" level="8">
    <decoded_as>Veeam MP</decoded_as>
    <description>$(Description)</description>
    <field name="Object">Attempt to Delete Backup</field>
    <field name="State">Failed</field>
    <mitre><id>T1565</id></mitre>
  </rule>

  <rule id="100078" level="8">
    <decoded_as>Veeam MP</decoded_as>
    <description>$(Description)</description>
    <field name="Object">Attempt To Update Security Object</field>
    <field name="State">Failed</field>
    <mitre><id>T1562</id></mitre>
  </rule>

  <rule id="100079" level="8">
    <decoded_as>Veeam MP</decoded_as>
    <description>$(Description)</description>
    <field name="Object">Invalid Code for Multi-Factor Authentication</field>
    <field name="State">Entered</field>
    <mitre><id>T1586</id></mitre>
  </rule>

  <rule id="100080" level="8">
    <decoded_as>Veeam MP</decoded_as>
    <description>$(Description)</description>
    <field name="Object">Allowed Attempts for Multi-Factor Authentication</field>
    <field name="State">Exceeded</field>
    <mitre><id>T1586</id></mitre>
  </rule>

  <rule id="100081" level="8">
    <decoded_as>Veeam MP</decoded_as>
    <description>$(Description)</description>
    <field name="Object">Failover Plan</field>
    <field name="State">Failed</field>
  </rule>

  <rule id="100082" level="8">
    <decoded_as>Veeam MP</decoded_as>
    <description>$(Description)</description>
    <field name="Object">Malware Detection Session</field>
    <field name="State">Failed</field>
    <mitre><id>T1587.001</id></mitre>
  </rule>
</group>

