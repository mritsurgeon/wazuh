<!-- v13.1/Field_Veeam_Rules_13.1.xml -->
<!-- Veeam Backup & Replication 13.1 -->
<!-- Field-specific rules for the security-relevant event subset (Users, -->
<!-- Credential Records, Malware Detection, Licenses, Security & Compliance -->
<!-- Analyzer categories from the live 13.1 scrape). Each rule is chained to -->
<!-- its generic counterpart via if_sid so one real event produces exactly -->
<!-- one alert (see design spec: v12.1's Field_Veeam_Rules.xml and -->
<!-- Generic_Veeam_rules.xml fire independently with no if_sid chaining, -->
<!-- causing double alerts per event; this file fixes that). -->
<!-- Object/State field matches are only added where the event's Description -->
<!-- literally contains the "have been" (plural) construction the -->
<!-- "Veeam MP 13.1 General" child decoder in v13.1/decoders_13.1.xml expects; -->
<!-- for the rest, the decoder would never fire, so those rules rely on -->
<!-- if_sid + decoded_as + $(Description) alone. -->

